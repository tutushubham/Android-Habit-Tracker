PRAGMA foreign_keys = 1;

CREATE TABLE categoryEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    display_order INTEGER NOT NULL,
    active INTEGER NOT NULL DEFAULT 1,
    updated_at INTEGER NOT NULL
);

CREATE TABLE dailyHabitEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    category_id TEXT REFERENCES categoryEntity(id) ON DELETE SET NULL,
    monthly_goal INTEGER NOT NULL,
    display_order INTEGER NOT NULL,
    active INTEGER NOT NULL DEFAULT 1,
    created_on TEXT NOT NULL,
    archived_on TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    kind TEXT NOT NULL DEFAULT 'ACTION',
    dated_only INTEGER NOT NULL DEFAULT 0
);

CREATE TABLE dailyCompletionEntity (
    plan_id TEXT NOT NULL,
    habit_id TEXT NOT NULL REFERENCES dailyHabitEntity(id) ON DELETE CASCADE,
    date TEXT NOT NULL,
    completed INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    pending_upload INTEGER NOT NULL DEFAULT 0,
    PRIMARY KEY (plan_id, date)
);

CREATE TABLE weeklyPlanEntity (
    habit_id TEXT NOT NULL REFERENCES dailyHabitEntity(id) ON DELETE CASCADE,
    weekday INTEGER NOT NULL,
    detail TEXT NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (habit_id, weekday)
);

CREATE TABLE dayPlanEntity (
    id TEXT NOT NULL PRIMARY KEY,
    habit_id TEXT NOT NULL REFERENCES dailyHabitEntity(id) ON DELETE CASCADE,
    date TEXT NOT NULL,
    detail TEXT NOT NULL,
    skipped INTEGER NOT NULL DEFAULT 0,
    updated_at INTEGER NOT NULL
);

CREATE TABLE weeklyHabitEntity (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    category_id TEXT REFERENCES categoryEntity(id) ON DELETE SET NULL,
    display_order INTEGER NOT NULL,
    active INTEGER NOT NULL DEFAULT 1,
    created_on TEXT NOT NULL,
    archived_on TEXT,
    created_at INTEGER NOT NULL,
    updated_at INTEGER NOT NULL
);

CREATE TABLE weeklyCompletionEntity (
    weekly_habit_id TEXT NOT NULL REFERENCES weeklyHabitEntity(id) ON DELETE CASCADE,
    week_start_date TEXT NOT NULL,
    completed INTEGER NOT NULL,
    updated_at INTEGER NOT NULL,
    PRIMARY KEY (weekly_habit_id, week_start_date)
);

CREATE TABLE settingsEntity (
    key TEXT NOT NULL PRIMARY KEY,
    value INTEGER NOT NULL
);

CREATE TABLE textSettingsEntity (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

CREATE INDEX dailyCompletionDateIndex ON dailyCompletionEntity(date);
CREATE INDEX dayPlanDateIndex ON dayPlanEntity(date);
CREATE INDEX weeklyCompletionDateIndex ON weeklyCompletionEntity(week_start_date);
CREATE INDEX dailyHabitCategoryIndex ON dailyHabitEntity(category_id);
CREATE INDEX weeklyHabitCategoryIndex ON weeklyHabitEntity(category_id);

selectAllCategories:
SELECT * FROM categoryEntity ORDER BY display_order, id;

selectCategoryCount:
SELECT COUNT(*) FROM categoryEntity;

insertCategory:
INSERT OR IGNORE INTO categoryEntity(id, name, display_order, active, updated_at)
VALUES (?, ?, ?, ?, ?);

updateCategory:
UPDATE categoryEntity
SET name = ?, display_order = ?, active = ?, updated_at = ?
WHERE id = ?;

deleteCategory:
DELETE FROM categoryEntity WHERE id = ?;

selectAllDailyHabits:
SELECT * FROM dailyHabitEntity ORDER BY display_order, id;

insertDailyHabit:
INSERT OR IGNORE INTO dailyHabitEntity(
    id, name, category_id, monthly_goal, display_order, active,
    created_on, archived_on, created_at, updated_at, kind, dated_only
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

updateDailyHabit:
UPDATE dailyHabitEntity
SET name = ?, category_id = ?, monthly_goal = ?, display_order = ?, active = ?,
    created_on = ?, archived_on = ?, updated_at = ?, kind = ?, dated_only = ?
WHERE id = ?;

updateDailyHabitOrder:
UPDATE dailyHabitEntity SET display_order = ?, updated_at = ? WHERE id = ?;

archiveDailyHabit:
UPDATE dailyHabitEntity
SET active = 0, archived_on = ?, updated_at = ?
WHERE id = ?;

restoreDailyHabit:
UPDATE dailyHabitEntity
SET active = 1, archived_on = NULL, updated_at = ?
WHERE id = ?;

deleteDailyHabit:
DELETE FROM dailyHabitEntity WHERE id = ?;

selectAllDailyCompletions:
SELECT * FROM dailyCompletionEntity ORDER BY date, habit_id;

selectAllWeeklyPlans:
SELECT * FROM weeklyPlanEntity ORDER BY weekday, habit_id;

upsertWeeklyPlan:
INSERT OR REPLACE INTO weeklyPlanEntity(habit_id, weekday, detail, updated_at) VALUES (?, ?, ?, ?);

deleteWeeklyPlan:
DELETE FROM weeklyPlanEntity WHERE habit_id = ? AND weekday = ?;

selectAllDayPlans:
SELECT * FROM dayPlanEntity ORDER BY date, habit_id;

upsertDayPlan:
INSERT OR REPLACE INTO dayPlanEntity(id, habit_id, date, detail, skipped, updated_at) VALUES (?, ?, ?, ?, ?, ?);

deleteDayPlan:
DELETE FROM dayPlanEntity WHERE habit_id = ? AND date = ?;

deleteDayPlanById:
DELETE FROM dayPlanEntity WHERE id = ?;

upsertDailyCompletion:
INSERT OR REPLACE INTO dailyCompletionEntity(plan_id, habit_id, date, completed, updated_at, pending_upload)
VALUES (?, ?, ?, ?, ?, ?);

isCompletionPending:
SELECT pending_upload FROM dailyCompletionEntity WHERE plan_id = ? AND date = ?;

-- Only clears the flag if the completion has not been touched since the snapshot that was uploaded.
acknowledgeCompletionUpload:
UPDATE dailyCompletionEntity SET pending_upload = 0 WHERE plan_id = ? AND date = ? AND updated_at = ?;

clearAllPendingUploads:
UPDATE dailyCompletionEntity SET pending_upload = 0;

selectAllWeeklyHabits:
SELECT * FROM weeklyHabitEntity ORDER BY display_order, id;

insertWeeklyHabit:
INSERT OR IGNORE INTO weeklyHabitEntity(
    id, name, category_id, display_order, active,
    created_on, archived_on, created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

updateWeeklyHabit:
UPDATE weeklyHabitEntity
SET name = ?, category_id = ?, display_order = ?, active = ?,
    created_on = ?, archived_on = ?, updated_at = ?
WHERE id = ?;

updateWeeklyHabitOrder:
UPDATE weeklyHabitEntity SET display_order = ?, updated_at = ? WHERE id = ?;

archiveWeeklyHabit:
UPDATE weeklyHabitEntity
SET active = 0, archived_on = ?, updated_at = ?
WHERE id = ?;

restoreWeeklyHabit:
UPDATE weeklyHabitEntity
SET active = 1, archived_on = NULL, updated_at = ?
WHERE id = ?;

deleteWeeklyHabit:
DELETE FROM weeklyHabitEntity WHERE id = ?;

selectAllWeeklyCompletions:
SELECT * FROM weeklyCompletionEntity ORDER BY week_start_date, weekly_habit_id;

upsertWeeklyCompletion:
INSERT OR REPLACE INTO weeklyCompletionEntity(weekly_habit_id, week_start_date, completed, updated_at)
VALUES (?, ?, ?, ?);

clearAllData:
DELETE FROM dailyHabitEntity;

clearAllDayPlans:
DELETE FROM dayPlanEntity;

clearAllWeeklyPlans:
DELETE FROM weeklyPlanEntity;

clearAllDailyCompletions:
DELETE FROM dailyCompletionEntity;

clearAllWeeklyCompletions:
DELETE FROM weeklyCompletionEntity;

clearAllWeeklyHabits:
DELETE FROM weeklyHabitEntity;

clearAllCategories:
DELETE FROM categoryEntity;

getSetting:
SELECT value FROM settingsEntity WHERE key = ?;

setSetting:
INSERT OR REPLACE INTO settingsEntity(key, value) VALUES (?, ?);

getTextSetting:
SELECT value FROM textSettingsEntity WHERE key = ?;

setTextSetting:
INSERT OR REPLACE INTO textSettingsEntity(key, value) VALUES (?, ?);
